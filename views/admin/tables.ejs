<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <title>
        Admin Tables | Royal Taste
    </title>

    <script src="https://cdn.tailwindcss.com"></script>

</head>


<body class="bg-[#F8F4EE] text-[#211A15]">


    <div class="p-10">


        <div class="flex justify-between items-center">


            <div>

                <h1 class="text-5xl font-serif font-bold">
                    Tables
                </h1>

                <p class="text-gray-500 mt-2">
                    Manage restaurant seating
                </p>

            </div>


            <button onclick="showForm()" class="
bg-[#8B5E34]
text-white
px-6
py-3
rounded-full
">

                + Add Table

            </button>


        </div>




        <!-- Add Table Form -->


        <div id="tableForm" class="hidden bg-white rounded-3xl p-8 mt-8 shadow">

            <h2 class="text-2xl font-bold mb-5">
                Add New Table
            </h2>



            <div class="grid md:grid-cols-3 gap-4">


                <input id="tableNumber" placeholder="Table Number" class="border p-3 rounded-xl" />



                <input id="capacity" placeholder="Capacity" class="border p-3 rounded-xl" />



                <input id="location" placeholder="Location" class="border p-3 rounded-xl" />


            </div>



            <button onclick="addTable()" class="
mt-5
bg-[#2C2118]
text-white
px-6
py-3
rounded-full
">

                Save

            </button>


        </div>





        <div id="tablesContainer" class="
grid
md:grid-cols-3
gap-6
mt-10
">

        </div>



    </div>



    <script src="/js/adminTables.js"></script>


</body>

</html>