<!DOCTYPE html>
<html lang="en">

<head>

    <title>
        Admin Customers | Royal Taste
    </title>

    <script src="https://cdn.tailwindcss.com"></script>

</head>


<body class="bg-[#F8F4EE] text-[#211A15]">


    <div class="p-10">


        <h1 class="text-5xl font-serif font-bold">
            Customers
        </h1>


        <p class="text-gray-500 mt-2">
            View customer information and booking history
        </p>




        <div id="customersContainer" class="
grid
md:grid-cols-3
gap-6
mt-10
">

        </div>



    </div>




    <script>


        async function loadCustomers() {


            const response =
                await fetch("/admin/customers");


            const data =
                await response.json();



            const container =
                document.getElementById(
                    "customersContainer"
                );



            container.innerHTML = "";



            data.customers.forEach(customer => {


                container.innerHTML += `


<div class="bg-white rounded-3xl p-6 shadow">


<h2 class="text-2xl font-bold">

${customer.name}

</h2>



<p class="text-gray-500 mt-2">

${customer.phone}

</p>



<p class="text-gray-500">

${customer.email}

</p>



<div class="mt-4">


<p>

Reservations:
<b>
${customer.totalReservations}
</b>

</p>



<p>

Last Visit:
<b>
${customer.lastVisit || "No visit"}
</b>

</p>


</div>




<a

href="/admin/customer-details/${customer._id}"

class="
inline-block
mt-5
bg-[#8B5E34]
text-white
px-5
py-2
rounded-full
"

>

View Details

</a>



</div>


`;


            });



        }



        loadCustomers();


    </script>



</body>

</html>