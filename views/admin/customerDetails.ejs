<!DOCTYPE html>
<html>

<head>

    <title>
        Customer Details
    </title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/theme.css">

</head>


<body class="bg-[#F8F4EE] text-[#211A15]">


    <div class="p-10 max-w-5xl mx-auto">


        <h1 class="text-5xl font-serif font-bold">

            Customer Details

        </h1>



        <div id="customerBox" class="
bg-white
rounded-3xl
p-8
mt-10
shadow
">

            Loading...

        </div>



    </div>



    <script>


        const id =
            window.location.pathname.split("/").pop();



        async function loadCustomer() {


            const response =
                await fetch(
                    `/admin/customers/${id}`
                );



            const data =
                await response.json();



            const customer =
                data.customer;


            const reservations =
                data.reservations;



            document.getElementById(
                "customerBox"
            ).innerHTML = `


<h2 class="text-3xl font-bold">

${customer.name}

</h2>



<p class="mt-3">
Phone:
${customer.phone}
</p>



<p>
Email:
${customer.email}
</p>




<h2 class="text-2xl font-bold mt-10">

Reservations

</h2>



<table class="w-full mt-5">


<tr class="border-b">

<th class="p-3 text-left">
Date
</th>

<th>
Time
</th>

<th>
Table
</th>

<th>
Status
</th>


</tr>



${reservations.map(r => `

<tr class="border-b">

<td class="p-3">

${r.reservationDate}

</td>


<td>

${r.startTime}

</td>


<td>

Table ${r.table.tableNumber}

</td>


<td>

${r.status}

</td>


</tr>


`).join("")
                }



</table>



`;



        }



        loadCustomer();



    </script>


</body>

</html>
