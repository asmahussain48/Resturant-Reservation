<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard | Royal Taste</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/theme.css">
</head>

<body class="bg-[#F8F4EE] text-[#211A15]">
    <%- include("../partials/adminNavbar") %>
    <div class="min-h-screen flex">
        <main class="flex-1 px-5 py-8 md:p-10 xl:p-12">
            <header class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-[4px] text-[#8B5E34]">Restaurant Overview</p>
                    <h1 class="text-4xl md:text-5xl font-bold mt-2">Dashboard</h1>
                    <p id="dashboardDate" class="text-gray-500 mt-2">Today's restaurant summary.</p>
                </div>
                <a href="/admin/reservations"
                    class="bg-[#8B5E34] text-white px-6 py-3 rounded-full font-medium hover:bg-[#6F451F] transition shadow-lg shadow-[#8B5E34]/20">
                    Manage Reservations
                </a>
            </header>

            <section class="grid sm:grid-cols-2 xl:grid-cols-3 gap-5 mt-9">
                <article class="bg-white border border-[#ECE3D8] rounded-3xl p-6">
                    <div class="flex items-center justify-between">
                        <p class="text-sm text-gray-500">Today's Reservations</p>
                        <span class="text-xs bg-[#F4ECE2] text-[#8B5E34] px-3 py-1 rounded-full">Today</span>
                    </div>
                    <p id="todayReservations" class="text-4xl font-bold mt-3">—</p>
                    <p class="text-xs text-gray-400 mt-2">Pending and confirmed bookings</p>
                </article>

                <article class="bg-white border border-[#ECE3D8] rounded-3xl p-6">
                    <p class="text-sm text-gray-500">Upcoming Reservations</p>
                    <p id="upcomingReservations" class="text-4xl font-bold mt-3">—</p>
                    <p class="text-xs text-gray-400 mt-2">Active bookings from today onward</p>
                </article>

                <article class="bg-white border border-[#ECE3D8] rounded-3xl p-6">
                    <p class="text-sm text-gray-500">Today's Expected Guests</p>
                    <p id="todayGuests" class="text-4xl font-bold mt-3">—</p>
                    <p class="text-xs text-gray-400 mt-2">Total guests across today's bookings</p>
                </article>

                <article class="bg-white border border-[#ECE3D8] rounded-3xl p-6">
                    <p class="text-sm text-gray-500">Available Tables</p>
                    <p id="availableTables" class="text-4xl font-bold text-green-700 mt-3">—</p>
                    <p class="text-xs text-gray-400 mt-2">Active tables not assigned today</p>
                </article>

                <article class="bg-white border border-[#ECE3D8] rounded-3xl p-6">
                    <p class="text-sm text-gray-500">Tables in Use Today</p>
                    <p id="occupiedTables" class="text-4xl font-bold text-[#8B5E34] mt-3">—</p>
                    <p class="text-xs text-gray-400 mt-2">Unique tables with active bookings</p>
                </article>

                <article class="bg-white border border-[#ECE3D8] rounded-3xl p-6">
                    <p class="text-sm text-gray-500">All-time Cancellations</p>
                    <p id="cancelledReservations" class="text-4xl font-bold text-red-600 mt-3">—</p>
                    <p class="text-xs text-gray-400 mt-2">Reservations marked as cancelled</p>
                </article>
            </section>

            <section class="bg-white border border-[#ECE3D8] rounded-3xl p-5 sm:p-7 mt-6 shadow-sm shadow-[#8B5E34]/5">
                <div class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
                    <div>
                        <div class="flex items-center gap-2">
                            <span class="h-2 w-2 rounded-full bg-[#8B5E34]"></span>
                            <p class="text-xs font-semibold uppercase tracking-[3px] text-[#8B5E34]">Last 7 Days</p>
                        </div>
                        <h2 class="text-xl sm:text-2xl font-bold mt-2">Reservation activity</h2>
                        <p class="text-sm text-gray-500 mt-1">Pending and confirmed bookings by day.</p>
                    </div>
                    <div class="grid grid-cols-3 gap-2 sm:gap-3" aria-label="Weekly reservation summary">
                        <div class="min-w-20 rounded-2xl bg-[#FAF7F2] px-3 py-2.5">
                            <p class="text-[10px] font-semibold uppercase tracking-wider text-gray-400">Total</p>
                            <p id="weeklyTotal" class="mt-1 text-lg font-bold text-[#211A15]">—</p>
                        </div>
                        <div class="min-w-20 rounded-2xl bg-[#FAF7F2] px-3 py-2.5">
                            <p class="text-[10px] font-semibold uppercase tracking-wider text-gray-400">Average</p>
                            <p id="weeklyAverage" class="mt-1 text-lg font-bold text-[#211A15]">—</p>
                        </div>
                        <div class="min-w-20 rounded-2xl bg-[#F4ECE2] px-3 py-2.5">
                            <p class="text-[10px] font-semibold uppercase tracking-wider text-[#8B5E34]">Peak</p>
                            <p id="weeklyPeak" class="mt-1 text-lg font-bold text-[#8B5E34]">—</p>
                        </div>
                    </div>
                </div>
                <div class="h-64 sm:h-72 mt-7">
                    <canvas id="weeklyReservationsChart" role="img"
                        aria-label="Bar chart showing reservations for each of the last seven days">
                        Reservations for the last seven days.
                    </canvas>
                </div>
            </section>

            <section class="bg-white border border-[#ECE3D8] rounded-3xl p-5 sm:p-7 mt-6 shadow-sm shadow-[#8B5E34]/5">
                <div class="flex flex-col gap-1">
                    <div class="flex items-center gap-2">
                        <span class="h-2 w-2 rounded-full bg-[#8B5E34]"></span>
                        <p class="text-xs font-semibold uppercase tracking-[3px] text-[#8B5E34]">All Reservations</p>
                    </div>
                    <h2 class="text-xl sm:text-2xl font-bold mt-2">Reservation status</h2>
                    <p class="text-sm text-gray-500">A clear breakdown of confirmed, pending, and cancelled bookings.</p>
                </div>

                <div class="mt-7 grid items-center gap-8 md:grid-cols-[minmax(240px,0.8fr)_minmax(280px,1.2fr)] lg:gap-14">
                    <div class="relative mx-auto h-60 w-full max-w-64 sm:h-64" id="statusChartContainer">
                        <canvas id="reservationStatusChart" role="img"
                            aria-label="Doughnut chart showing confirmed, pending, and cancelled reservations">
                            Reservation status breakdown.
                        </canvas>
                    </div>

                    <div id="statusLegend" class="space-y-3" aria-label="Reservation status totals">
                        <div class="animate-pulse rounded-2xl bg-[#FAF7F2] h-16"></div>
                        <div class="animate-pulse rounded-2xl bg-[#FAF7F2] h-16"></div>
                        <div class="animate-pulse rounded-2xl bg-[#FAF7F2] h-16"></div>
                    </div>
                </div>
            </section>

            <section class="bg-white border border-[#ECE3D8] rounded-3xl p-5 sm:p-7 mt-6 shadow-sm shadow-[#8B5E34]/5">
                <div class="flex flex-col gap-5 sm:flex-row sm:items-start sm:justify-between">
                    <div>
                        <div class="flex items-center gap-2">
                            <span class="h-2 w-2 rounded-full bg-[#8B5E34]"></span>
                            <p class="text-xs font-semibold uppercase tracking-[3px] text-[#8B5E34]">Booking Patterns</p>
                        </div>
                        <h2 class="text-xl sm:text-2xl font-bold mt-2">Peak reservation hours</h2>
                        <p class="text-sm text-gray-500 mt-1">See when guests prefer to book their tables.</p>
                    </div>

                    <div class="rounded-2xl bg-[#F4ECE2] px-4 py-3 sm:min-w-36">
                        <p class="text-[10px] font-semibold uppercase tracking-wider text-[#8B5E34]">Busiest hour</p>
                        <div class="mt-1 flex items-baseline gap-2">
                            <p id="busiestHour" class="text-xl font-bold text-[#8B5E34]">—</p>
                            <p id="busiestHourCount" class="text-xs font-medium text-[#8B5E34]/70"></p>
                        </div>
                    </div>
                </div>

                <div id="peakHoursChartContainer" class="h-72 sm:h-80 mt-7">
                    <canvas id="peakHoursChart" role="img"
                        aria-label="Bar chart showing reservation totals grouped by hour">
                        Peak reservation hours.
                    </canvas>
                </div>
                <div id="peakHoursEmpty" class="hidden h-64 items-center justify-center rounded-2xl bg-[#FAF7F2] text-center">
                    <div>
                        <p class="font-semibold text-[#211A15]">No booking activity yet</p>
                        <p class="mt-1 text-sm text-gray-500">Hourly trends will appear after reservations are added.</p>
                    </div>
                </div>
            </section>
        </main>
    </div>

    <div id="dashboardError"
        class="hidden fixed right-5 bottom-5 z-50 bg-red-600 text-white px-5 py-4 rounded-2xl shadow-2xl"></div>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.5.1/dist/chart.umd.min.js"></script>
    <script src="/js/adminDashboard.js"></script>
</body>

</html>
