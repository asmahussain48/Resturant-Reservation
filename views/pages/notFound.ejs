<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Page Not Found | Royal Taste</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/theme.css" />
  </head>

  <body class="bg-[#F8F4EE] text-[#211A15] min-h-screen">
    <%- include("../partials/navbar") %>

    <section class="min-h-[70vh] flex items-center justify-center px-6 text-center">
      <div>
        <p class="uppercase tracking-[5px] text-xs text-[#8B5E34] font-semibold">
          404
        </p>
        <h1 class="font-serif text-5xl md:text-6xl font-bold mt-4">
          Page Not Found
        </h1>
        <p class="text-gray-500 mt-4 max-w-md mx-auto">
          The page you are looking for does not exist or may have moved.
        </p>
        <a
          href="/"
          class="inline-block mt-10 bg-[#2C2118] text-white px-8 py-4 rounded-full font-semibold hover:bg-[#8B5E34]"
        >
          Back to Home
        </a>
      </div>
    </section>
  </body>
</html>
