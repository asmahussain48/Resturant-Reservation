<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Reservation Details | Royal Taste</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/theme.css">
  </head>

  <body class="bg-[#F8F4EE] text-[#211A15] min-h-screen">
    <%- include("../partials/navbar") %>
    <section class="px-6 py-12">
      <div class="max-w-4xl mx-auto">
        <a href="/my-reservations" class="text-gray-500 hover:text-[#8B5E34]">
          ← Back to Reservations
        </a>

        <div class="text-center mt-10 mb-12">
          <p class="uppercase tracking-[5px] text-xs text-[#8B5E34]">
            Royal Taste
          </p>

          <h1 class="font-serif text-5xl font-bold mt-4">
            Reservation Details
          </h1>

          <p class="text-gray-500 mt-3">Your booking information</p>
        </div>

        <div
          id="detailsContainer"
          class="bg-white border border-[#E9DFD3] rounded-[35px] p-8 shadow-sm"
        >
          <p class="text-center text-gray-500">Loading reservation...</p>
        </div>
      </div>
    </section>

    <script>
      const id = window.location.pathname.split("/").pop();

      async function loadReservation() {
        try {
          const response = await fetch(`/api/reservations/${id}`);

          const data = await response.json();

          const container = document.getElementById("detailsContainer");

          if (!data.success) {
            container.innerHTML = `

<div class="text-center">

<h2 class="text-2xl font-bold">
Reservation Not Found
</h2>


<p class="text-gray-500 mt-2">
${data.message}
</p>


</div>

`;

            return;
          }

          const reservation = data.reservation;

          container.innerHTML = `


<div class="flex justify-between items-start mb-8">


<div>

<h2 class="text-3xl font-serif font-bold">

Table ${reservation.table.tableNumber}

</h2>


<p class="text-gray-500 mt-2">

📍 ${reservation.table.location}

</p>


</div>



<span
class="
px-5 py-2 rounded-full
${
  reservation.status === "confirmed"
    ? "bg-green-100 text-green-700"
    : "bg-red-100 text-red-700"
}
"
>

${reservation.status}

</span>



</div>





<div class="grid md:grid-cols-2 gap-6">



<div class="bg-[#FAF7F2] rounded-2xl p-5">


<p class="text-gray-400 text-sm">
Customer Name
</p>


<p class="font-semibold text-lg">
${reservation.customerName}
</p>


</div>




<div class="bg-[#FAF7F2] rounded-2xl p-5">


<p class="text-gray-400 text-sm">
Phone
</p>


<p class="font-semibold text-lg">
${reservation.phone}
</p>


</div>




<div class="bg-[#FAF7F2] rounded-2xl p-5">


<p class="text-gray-400 text-sm">
Date
</p>


<p class="font-semibold text-lg">
${reservation.reservationDate}
</p>


</div>




<div class="bg-[#FAF7F2] rounded-2xl p-5">


<p class="text-gray-400 text-sm">
Time
</p>


<p class="font-semibold text-lg">

${reservation.startTime}
-
${reservation.endTime}

</p>


</div>




<div class="bg-[#FAF7F2] rounded-2xl p-5">


<p class="text-gray-400 text-sm">
People
</p>


<p class="font-semibold text-lg">
${reservation.numberOfPeople}
</p>


</div>




<div class="bg-[#FAF7F2] rounded-2xl p-5">


<p class="text-gray-400 text-sm">
Table Capacity
</p>


<p class="font-semibold text-lg">
${reservation.table.capacity}
</p>


</div>



</div>



`;
        } catch (error) {
          console.log(error);
        }
      }

      loadReservation();
    </script>
  </body>
</html>
