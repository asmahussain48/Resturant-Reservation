<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Reserve Your Table | Royal Taste</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/theme.css">
  </head>

  <body class="bg-[#F8F4EE] text-[#211A15] min-h-screen">
    <%- include("../partials/navbar") %>
    <!-- HEADER -->

    <section class="px-6 pt-12 pb-8">
      <div class="max-w-5xl mx-auto">
        <a href="/menu" class="text-sm text-gray-500 hover:text-[#8B5E34]">
          ← Back to Menu
        </a>

        <div class="text-center mt-8">
          <p
            class="uppercase tracking-[5px] text-xs text-[#8B5E34] font-semibold"
          >
            Royal Taste
          </p>

          <h1 class="font-serif text-5xl md:text-6xl font-bold mt-4">
            Reserve Your Table
          </h1>

          <p class="text-gray-500 mt-4 max-w-xl mx-auto">
            Choose your date, time and party size. We will show available
            tables.
          </p>
        </div>
      </div>
    </section>

    <!-- PROGRESS BAR -->

    <section class="px-6 pb-10">
      <div class="max-w-4xl mx-auto">
        <div
          class="bg-white border border-[#E9DFD3] rounded-full px-5 py-4 flex items-center justify-between"
        >
          <div class="flex items-center gap-2">
            <div
              id="progress1"
              class="w-8 h-8 rounded-full bg-[#2C2118] text-white flex items-center justify-center"
            >
              1
            </div>

            <span class="hidden sm:block text-sm font-semibold">
              Date & Time
            </span>
          </div>

          <div class="h-px flex-1 bg-[#DED5CA] mx-4"></div>

          <div class="flex items-center gap-2">
            <div
              id="progress2"
              class="w-8 h-8 rounded-full bg-[#EDE5DC] text-gray-500 flex items-center justify-center"
            >
              2
            </div>

            <span class="hidden sm:block text-sm text-gray-400">Table</span>
          </div>

          <div class="h-px flex-1 bg-[#DED5CA] mx-4"></div>

          <div class="flex items-center gap-2">
            <div
              id="progress3"
              class="w-8 h-8 rounded-full bg-[#EDE5DC] text-gray-500 flex items-center justify-center"
            >
              3
            </div>

            <span class="hidden sm:block text-sm text-gray-400">Details</span>
          </div>

          <div class="h-px flex-1 bg-[#DED5CA] mx-4"></div>

          <div class="flex items-center gap-2">
            <div
              id="progress4"
              class="w-8 h-8 rounded-full bg-[#EDE5DC] text-gray-500 flex items-center justify-center"
            >
              4
            </div>

            <span class="hidden sm:block text-sm text-gray-400">Confirm</span>
          </div>
        </div>
      </div>
    </section>

    <main class="px-6 pb-20">
      <!-- STEP 1 -->

      <div
        id="stepOne"
        class="max-w-4xl mx-auto bg-white border border-[#E9DFD3] rounded-[35px] p-7 md:p-10 shadow-sm"
      >
        <div class="mb-10">
          <p class="text-xs uppercase tracking-[4px] text-[#8B5E34]">Step 01</p>

          <h2 class="font-serif text-3xl font-bold mt-2">
            When would you like to visit?
          </h2>

          <p class="text-gray-500 mt-2">
            Reservations are available Monday to Sunday.
          </p>
        </div>

        <!-- DATE -->

        <div class="mb-10">
          <label class="block font-semibold mb-4">Choose Date</label>

          <div
            id="dateOptions"
            class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-3"
          ></div>
        </div>

        <!-- TIME -->

        <div class="mb-10">
          <label id="timeSlotLabel" class="block font-semibold mb-4">
            Choose Time Slot
          </label>

          <div id="timeOptions" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
            <p class="text-sm text-gray-500 col-span-full">Loading available times...</p>
          </div>
        </div>

        <!-- PEOPLE -->

        <div class="mb-10">
          <label class="block font-semibold mb-4">Number of People</label>

          <select
            id="numberOfPeople"
            class="w-full md:w-72 bg-[#FAF7F2] border border-[#DDD2C5] rounded-2xl px-5 py-4"
          >
            <option value="">Select party size</option>

            <option value="1">1 Person</option>

            <option value="2">2 People</option>

            <option value="3">3 People</option>

            <option value="4">4 People</option>

            <option value="5">5 People</option>

            <option value="6">6 People</option>

            <option value="7">7 People</option>

            <option value="8">8 People</option>

            <option value="9">9 People</option>

            <option value="10">10 People</option>
          </select>
        </div>

        <div
          id="errorMessage"
          class="hidden bg-red-50 text-red-600 border border-red-200 rounded-2xl px-5 py-4 mb-6"
        ></div>

        <div class="flex justify-end pt-6 border-t border-[#EEE5DB]">
          <button
            id="findTablesButton"
            type="button"
            class="bg-[#2C2118] text-white px-8 py-4 rounded-full font-semibold hover:bg-[#8B5E34]"
          >
            Find Available Tables →
          </button>
        </div>
      </div>
      <!-- STEP 2 TABLES -->

      <div
        id="tablesSection"
        class="hidden max-w-4xl mx-auto mt-10 bg-white border border-[#E9DFD3] rounded-[35px] p-7 md:p-10"
      >
        <div class="mb-6">
          <p class="text-xs uppercase tracking-[4px] text-[#8B5E34]">Step 02</p>

          <h2 class="font-serif text-3xl font-bold mt-2">Choose Your Table</h2>

          <p class="text-gray-500 mt-2">
            Available tables for your selected time.
          </p>
        </div>

        <div
          id="tablesGrid"
          class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5"
        ></div>
      </div>

      <!-- STEP 3 CUSTOMER -->

      <div
        id="customerSection"
        class="hidden max-w-4xl mx-auto mt-10 bg-white border border-[#E9DFD3] rounded-[35px] p-7 md:p-10"
      >
        <div class="mb-6">
          <p class="text-xs uppercase tracking-[4px] text-[#8B5E34]">Step 03</p>

          <h2 class="font-serif text-3xl font-bold mt-2">Your Information</h2>

          <p class="text-gray-500 mt-2">
            Enter details to confirm reservation.
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-5">
          <div>
            <label class="block font-semibold mb-2">Name</label>

            <input
              id="customerName"
              type="text"
              placeholder="Enter your name"
              class="w-full bg-[#FAF7F2] border border-[#DDD2C5] rounded-2xl px-5 py-4"
            />
          </div>

          <div>
            <label class="block font-semibold mb-2">Phone</label>

            <input
              id="customerPhone"
              type="text"
              placeholder="03xxxxxxxxx"
              class="w-full bg-[#FAF7F2] border border-[#DDD2C5] rounded-2xl px-5 py-4"
            />
          </div>
        </div>

        <button
          id="confirmReservationButton"
          class="bg-[#8B5E34] text-white px-8 py-3 rounded-xl"
        >
          Confirm Reservation
        </button>
      </div>
      <section
        id="confirmationSection"
        class="hidden bg-white rounded-3xl p-10 mt-10 shadow-xl"
      >
        <div id="confirmationData"></div>

        <a
          href="/my-reservations"
          class="inline-block mt-8 bg-[#8B5E34] text-white px-8 py-3 rounded-xl"
        >
          View My Reservations
        </a>
      </section>

      <script>
        let selectedDate = "";
        let selectedTime = "";
        let selectedTable = null;

        // Elements

        const dateOptions = document.getElementById("dateOptions");

        const timeOptions = document.getElementById("timeOptions");

        const timeSlotLabel = document.getElementById("timeSlotLabel");

        const numberOfPeople = document.getElementById("numberOfPeople");

        const findTablesButton = document.getElementById("findTablesButton");

        const stepOne = document.getElementById("stepOne");

        const tablesSection = document.getElementById("tablesSection");

        const tablesGrid = document.getElementById("tablesGrid");

        const customerSection = document.getElementById("customerSection");

        const customerName = document.getElementById("customerName");

        const customerPhone = document.getElementById("customerPhone");

        const progress1 = document.getElementById("progress1");

        const progress2 = document.getElementById("progress2");

        const progress3 = document.getElementById("progress3");

        const progress4 = document.getElementById("progress4");

        const confirmReservationButton = document.getElementById(
          "confirmReservationButton",
        );

        // Progress

        function updateProgress(step) {
          const active =
            "w-8 h-8 rounded-full bg-[#2C2118] text-white flex items-center justify-center";

          const inactive =
            "w-8 h-8 rounded-full bg-[#EDE5DC] text-gray-500 flex items-center justify-center";

          progress1.className = step >= 1 ? active : inactive;

          progress2.className = step >= 2 ? active : inactive;

          progress3.className = step >= 3 ? active : inactive;

          progress4.className = step >= 4 ? active : inactive;
        }

        // Create next 7 days

        function createNextSevenDays() {
          const today = new Date();

          for (let i = 0; i < 7; i++) {
            const date = new Date(today);

            date.setDate(today.getDate() + i);

            const value =
              date.getFullYear() +
              "-" +
              String(date.getMonth() + 1).padStart(2, "0") +
              "-" +
              String(date.getDate()).padStart(2, "0");

            const button = document.createElement("button");

            button.type = "button";

            button.dataset.date = value;

            button.className = `
        date-btn
        bg-[#FAF7F2]
        border
        border-[#DDD2C5]
        rounded-2xl
        py-4
        `;

            button.innerHTML = `

        <span class="block text-xs text-gray-400">
        ${date.toLocaleDateString("en-US", {
          weekday: "short",
        })}
        </span>


        <span class="text-2xl font-bold">
        ${date.getDate()}
        </span>


        <span class="block text-xs text-gray-400">
        ${date.toLocaleDateString("en-US", {
          month: "short",
        })}
        </span>

        `;

            button.onclick = function () {
              selectedDate = this.dataset.date;

              document.querySelectorAll(".date-btn").forEach((btn) => {
                btn.className = `
                date-btn
                bg-[#FAF7F2]
                border
                border-[#DDD2C5]
                rounded-2xl
                py-4
                `;
              });

              this.className = `
            date-btn
            bg-[#2C2118]
            text-white
            rounded-2xl
            py-4
            `;
            };

            dateOptions.appendChild(button);
          }
        }

        function formatReservationTime(time) {
          const [hourText, minute] = time.split(":");
          const hour = Number(hourText);
          const suffix = hour >= 12 ? "PM" : "AM";
          return `${hour % 12 || 12}:${minute} ${suffix}`;
        }

        function addHoursToTime(time, duration) {
          const [hour, minute] = time.split(":").map(Number);
          const totalMinutes = hour * 60 + minute + duration * 60;
          const endHour = Math.floor(totalMinutes / 60) % 24;
          const endMinute = totalMinutes % 60;
          return `${String(endHour).padStart(2, "0")}:${String(endMinute).padStart(2, "0")}`;
        }

        function selectTime(button) {
          selectedTime = button.dataset.time;

          document.querySelectorAll(".time-btn").forEach((btn) => {
            btn.className =
              "time-btn border border-[#DDD2C5] rounded-2xl py-4 px-3 hover:border-[#8B5E34] transition";
          });

          button.className =
            "time-btn bg-[#2C2118] text-white rounded-2xl py-4 px-3 shadow-lg";
        }

        async function loadReservationSlots() {
          try {
            const response = await fetch("/reservation-slots");
            const data = await response.json();

            if (!response.ok) {
              throw new Error(data.message || "Unable to load reservation times");
            }

            timeOptions.innerHTML = "";
            timeSlotLabel.textContent = `Choose ${data.slotDuration}-Hour Time Slot`;

            if (!data.isOpen) {
              timeOptions.innerHTML = `
                <div class="col-span-full bg-red-50 border border-red-200 text-red-600 rounded-2xl p-5">
                  The restaurant is currently closed for new reservations.
                </div>
              `;
              findTablesButton.disabled = true;
              findTablesButton.classList.add("opacity-50", "cursor-not-allowed");
              return;
            }

            if (data.slots.length === 0) {
              timeOptions.innerHTML = `
                <p class="col-span-full text-gray-500">No reservation times are available.</p>
              `;
              return;
            }

            data.slots.forEach((time) => {
              const button = document.createElement("button");
              const endTime = addHoursToTime(time, data.slotDuration);

              button.type = "button";
              button.dataset.time = time;
              button.className =
                "time-btn border border-[#DDD2C5] rounded-2xl py-4 px-3 hover:border-[#8B5E34] transition";
              button.innerHTML = `
                <span class="block font-semibold">${formatReservationTime(time)}</span>
                <span class="text-xs text-gray-400">to ${formatReservationTime(endTime)}</span>
              `;
              button.addEventListener("click", () => selectTime(button));
              timeOptions.appendChild(button);
            });
          } catch (error) {
            timeOptions.innerHTML = `
              <p class="col-span-full text-red-600">${error.message}</p>
            `;
          }
        }

        // Find available tables

        findTablesButton.onclick = async function () {
          if (!selectedDate) {
            alert("Select date");

            return;
          }

          if (!selectedTime) {
            alert("Select time");

            return;
          }

          if (!numberOfPeople.value) {
            alert("Select people");

            return;
          }

          const response = await fetch(
            `/api/availability?date=${selectedDate}&startTime=${selectedTime}&people=${numberOfPeople.value}`,
          );

          const data = await response.json();

          if (data.success) {
            showTables(data.availableTables);
          } else {
            alert(data.message);
          }
        };

        // Show tables

        function showTables(tables) {
          tablesGrid.innerHTML = "";

          if (tables.length === 0) {
            tablesGrid.innerHTML = `
        <p class="text-gray-500">
        No tables available for this slot.
        </p>
        `;

            return;
          }

          tables.forEach((table) => {
            const card = document.createElement("button");

            card.className = `
        table-card
        bg-[#FAF7F2]
        border
        border-[#DDD2C5]
        rounded-3xl
        p-6
        text-left
        transition
        duration-300
        hover:shadow-lg
        `;

            card.innerHTML = `


        <div class="text-5xl">
        🪑
        </div>


        <h3 class="text-2xl font-bold mt-4">
        Table ${table.tableNumber}
        </h3>


        <p>
        Capacity:
        ${table.capacity}
        </p>


        <p class="text-[#8B5E34]">
        ${table.location}
        </p>

        `;

            card.onclick = function () {
              document.querySelectorAll(".table-card").forEach((btn) => {
                btn.className = `
                table-card
                bg-[#FAF7F2]
                border
                border-[#DDD2C5]
                rounded-3xl
                p-6
                text-left
                transition
                duration-300
                hover:shadow-lg
                `;
              });

              this.className = `
            table-card
            bg-[#2C2118]
            text-white
            border
            border-[#8B5E34]
            rounded-3xl
            p-6
            shadow-xl
            scale-105
            `;

              selectedTable = table._id;

              customerSection.classList.remove("hidden");

              updateProgress(3);

              customerSection.scrollIntoView({
                behavior: "smooth",
              });
            };

            tablesGrid.appendChild(card);
          });

          stepOne.classList.add("hidden");

          tablesSection.classList.remove("hidden");

          updateProgress(2);
        }

        // Confirm reservation

        confirmReservationButton.onclick = async function () {
          if (!selectedTable) {
            alert("Please select table");

            return;
          }

          const reservationData = {
            tableId: selectedTable,

            reservationDate: selectedDate,

            startTime: selectedTime,

            numberOfPeople: Number(numberOfPeople.value),

            customerName: customerName.value,

            phone: customerPhone.value,
          };

          confirmReservationButton.disabled = true;
          confirmReservationButton.textContent = "Confirming...";

          try {
            const response = await fetch("/reservations", {
              method: "POST",

              headers: {
                "Content-Type": "application/json",
              },

              body: JSON.stringify(reservationData),
            });

            const data = await response.json();

            if (!response.ok || !data.success) {
              const message =
                data.message ||
                data.errors?.[0]?.msg ||
                "Unable to create reservation. Please try again.";

              alert(message);
              return;
            }

            alert(data.message || "Reservation created successfully");
            updateProgress(4);
            window.location.href = "/my-reservations";
          } catch (error) {
            alert("Unable to connect to the server. Please try again.");
          } finally {
            confirmReservationButton.disabled = false;
            confirmReservationButton.textContent = "Confirm Reservation";
          }
        };

        // Start

        createNextSevenDays();
        loadReservationSlots();
      </script>
    </main>
  </body>
</html>
